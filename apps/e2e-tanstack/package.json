{
  "name": "e2e-tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --bun run server.dev.ts",
    "generate-routes": "tsr generate",
    "build": "NODE_ENV=production bun run build:frontend && bun run build:server",
    "build:frontend": "bun --bun vite build",
    "build:server": "bun build --target bun --outfile dist/app server.prod.ts",
    "start": "NODE_ENV=production bun dist/app",
    "test:integration": "bun test ./tests"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@typeway/server": "workspace:*",
    "elysia": "2.0.0-rc.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.168.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "seroval": "^1.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
