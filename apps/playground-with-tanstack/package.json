{
  "name": "playground-with-tanstack",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --bun --watch run server.dev.ts",
    "dev:vite": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "NODE_ENV=production bun run build:frontend && bun run build:server",
    "build:frontend": "bun --bun vite build",
    "build:server": "bun build --target bun --outfile dist/app server.prod.ts",
    "start": "NODE_ENV=production bun dist/app",
    "preview": "vite preview",
    "test:integration": "bun test tests/",
    "auth:generate": "bun --bun x auth generate --config server/auth.ts --output db/auth.schema.ts --yes",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@typeway/connect": "workspace:*",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^2.0.0-beta.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "auth": "1.7.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}