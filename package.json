{
  "name": "@typeway/workspace",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test packages/",
    "test:integration": "bun run --filter playground-with-tanstack test:integration",
    "test:e2e-tanstack": "bun run --filter e2e-tanstack test:integration",
    "typecheck": "bun check -p tsconfig.json && bun check -p apps/playground-with-tanstack && bun check -p apps/e2e-tanstack",
    "bench": "bun bench/run.ts",
    "bench:micro": "cd bench && bun install && bun micro.ts",
    "dev": "bun run --filter @typeway/playground dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
