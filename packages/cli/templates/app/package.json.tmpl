{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --bun --watch run server.dev.ts",
    "generate-routes": "tsr generate",
    "build": "NODE_ENV=production bun run build:frontend && bun run build:server",
    "build:frontend": "bun --bun vite build",
    "build:server": "bun build --target bun --outfile dist/app server.prod.ts",
    "start": "NODE_ENV=production bun dist/app",
    "test": "bun test",
    "typecheck": "bun check",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@elysia/eden": "2.0.0-rc.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@typeway/server": "{{typewayServer}}",
    "drizzle-orm": "1.0.0-rc.5",
    "elysia": "2.0.0-rc.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.168.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "1.0.0-rc.5",
    "typeway": "{{typewayCli}}",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
